# systemd: the API runs continuously and comes back up by itself after a server reboot.
# Installation:
#   sudo cp deploy/firesync-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now firesync-api
# Logs:  journalctl -u firesync-api -f

[Unit]
Description=FireSync API (FastAPI)
After=network.target

[Service]
Type=simple
User=firesync
WorkingDirectory=/srv/FireSync/backend
# Address of the website (frontend) that is allowed to call the API
Environment=FRONTEND_URLS=https://YOUR-FRONTEND-DOMAIN
# NASA updates run inside the API (updater.py); one process is enough and keeps one updater
ExecStart=/srv/FireSync/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
