# systemd: API работает постоянно и сам поднимается после перезагрузки сервера.
# Установка:
#   sudo cp deploy/firesync-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now firesync-api
# Логи:  journalctl -u firesync-api -f

[Unit]
Description=FireSync API (FastAPI)
After=network.target

[Service]
Type=simple
User=firesync
WorkingDirectory=/srv/FireSync/backend
# Адрес сайта (фронтенда), которому можно обращаться к API
Environment=FRONTEND_URLS=https://YOUR-FRONTEND-DOMAIN
ExecStart=/srv/FireSync/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
